# Charter indexer — server-side configuration.
# Copy to .env and fill in. Keep the passphrase quoted (semicolon breaks bash sourcing).

DATABASE_URL="postgres://charter:charter@localhost:5432/charter?sslmode=disable"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# The factory contract id the indexer bootstraps its treasury watch list from.
FACTORY_CONTRACT_ID=""

PORT="8080"

# How often (seconds) the ingestion loop polls getEvents.
POLL_INTERVAL_SECONDS="5"
