# Charter web — public runtime configuration.
# Copy to .env.local and fill in the deployed contract id after charter-contract deploys.
#
# NOTE: NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE MUST stay quoted — the semicolon
# breaks unquoted bash sourcing of this file.

NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Filled in after charter-contract's deploy script runs.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=""

# Informational only (shown in the new-org flow). Filled in after treasury wasm upload.
NEXT_PUBLIC_TREASURY_WASM_HASH=""

# Indexer REST base URL. Local dev: http://localhost:8080. No localhost fallback ships to prod.
NEXT_PUBLIC_INDEXER_API_URL="http://localhost:8080"

# Any funded testnet account public key — used only as the source for read-only simulations.
NEXT_PUBLIC_READ_ONLY_SOURCE_ACCOUNT=""
